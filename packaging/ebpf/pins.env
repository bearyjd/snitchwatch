# Pins for packaging/ebpf/build-modules.sh (plain KEY=value lines, sourced by
# bash and parsed by crates/snitchwatch-bridge/tests/ebpf_modules_shape.rs).
#
# Must equal packaging/release/pins.env SW_OPENSNITCH_COMMIT: the daemon and
# the .o modules have to come from the same opensnitch commit (runbook 5a).
SW_OPENSNITCH_COMMIT=a1353848ba1b660320e90cefea782c3fba272c00
# Major versions of the BPF toolchain (`clang --version`, `llvm-strip --version`).
# UNVERIFIED: chosen for Fedora 45; confirm on the tower before the first build.
SW_EBPF_CLANG_MAJOR=21
SW_EBPF_LLVM_MAJOR=21
# Upstream kernel version whose headers the modules are compiled against; passed
# to the Makefile as KERNEL_VER (6.19+ adds extra flags). The `kernel-devel`
# package must match the target image kernel. UNVERIFIED: taken from the tower
# host kernel 7.2.15-ogc1.1.fc45; re-check against the image before relying on it.
SW_EBPF_KERNEL_DEVEL_VERSION=7.2.15
