# Pins for packaging/ebpf/build-modules.sh (plain KEY=value lines; parsed, never
# sourced, by the script and by crates/snitchwatch-bridge/tests/ebpf_modules_shape.rs).
# Formats are enforced: commit ^[0-9a-f]{40}$, majors ^[0-9]+$, tree ^[0-9a-f]{64}$.
#
# Must equal packaging/release/pins.env SW_OPENSNITCH_COMMIT: the daemon and
# the .o modules have to come from the same opensnitch commit (runbook 5a).
SW_OPENSNITCH_COMMIT=a1353848ba1b660320e90cefea782c3fba272c00
# sha256 of the ebpf_prog tree of SW_OPENSNITCH_COMMIT, extracted from raw blobs
# (no git attributes/filters): (cd TREE && find . -type f -print0 | LC_ALL=C sort -z |
# xargs -0 sha256sum) | sha256sum. Covers paths + contents, not mtimes/modes (every
# file must be mode 100644). Recompute whenever SW_OPENSNITCH_COMMIT moves.
SW_EBPF_PROG_TREE_SHA256=c37c309a548ec5518aec25bd4602d7c5672fb8e94ab9430893615aeafe0e4537
# Major versions of the BPF toolchain (`clang --version`, `llvm-strip --version`).
# VERIFIED 2026-11-16 on Fedora 45 (clang21/llvm21 21.1.8-10.fc45): all three
# modules build at SW_OPENSNITCH_COMMIT against the 7.2.15-ogc1.1 and 7.3.4-ogc6.1
# kernel-devel trees. clang/llvm 23 does NOT work (llc rejects the host-target
# bitcode: "Target-incompatible DataLayout"). On Fedora 45 clang21/llvm21 install
# the VERSIONED names clang-21, llc-21 and llvm-strip-21 (also under
# /usr/lib64/llvm21/bin); build-modules.sh looks up the UNVERSIONED clang, llc and
# llvm-strip on its fixed PATH and checks their major against the pins below, so
# the builder must make those names resolve to the 21 binaries (for example a
# toolbox/container where clang21/llvm21 are the only compiler installed, or
# symlinks). The bazzite-tower image build uses its own stage with the versioned names.
SW_EBPF_CLANG_MAJOR=21
SW_EBPF_LLVM_MAJOR=21
SW_EBPF_LLC_MAJOR=21
# There is deliberately no kernel version pin here: the modules are not CO-RE, so
# the target kernel is whatever the image ships. build-modules.sh requires
# --kernel-ver (the release of the image's kernel-devel) and refuses any kernel
# tree that does not match it.
